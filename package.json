{
  "name": "nexus-fit",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "serve:prod": "node .next/standalone/server.js",
    "docker:build": "docker build -t nexusfit-app -f deploy/Dockerfile .",
    "docker:up": "docker compose --env-file deploy/.env -f deploy/docker-compose.yml up -d --build",
    "docker:down": "docker compose --env-file deploy/.env -f deploy/docker-compose.yml down",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "tenant:create": "node scripts/create-tenant.mjs",
    "tenant:password": "node scripts/set-tenant-password.mjs",
    "demo:dev": "vite --config site/vite.config.mts",
    "demo:build": "vite build --config site/vite.config.mts",
    "demo:preview": "vite preview --config site/vite.config.mts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:docs": "node scripts/check-docs-drift.mjs",
    "test": "vitest run",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "sbom": "npx --yes @cyclonedx/cyclonedx-npm@6.0.1 --output-file sbom.json"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "next": "16.4.3",
    "qrcode.react": "^4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^30.1.3",
    "postcss": "^8",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.1",
    "typescript": "^7",
    "vite": "^8.3.5",
    "vitest": "^5.0.0"
  }
}
