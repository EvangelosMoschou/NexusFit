{
  "name": "nexus-fit",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "serve:prod": "node .next/standalone/server.js",
    "docker:build": "docker build -t nexusfit-app -f deploy/Dockerfile .",
    "docker:up": "docker compose -f deploy/docker-compose.yml up -d",
    "docker:down": "docker compose -f deploy/docker-compose.yml down",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "tenant:create": "node scripts/create-tenant.mjs",
    "demo:dev": "vite --config site/vite.config.mts",
    "demo:build": "vite build --config site/vite.config.mts",
    "demo:preview": "vite preview --config site/vite.config.mts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "next": "15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "15.1.7",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^30.1.3",
    "postcss": "^8",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^5.0.0"
  }
}
