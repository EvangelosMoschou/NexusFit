# ==============================================================================
# NEXUSFIT PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000

# 1. AI AGENT API KEY (Google AI Studio - Gemini 2.0 Flash-Lite)
# Αποκτήστε δωρεάν κλειδί στο: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Προαιρετικό: Ορισμός μοντέλου (Default: gemini-2.0-flash-lite)
GEMINI_MODEL=gemini-2.0-flash-lite

# 2. ΑΥΤΟΝΟΜΗ ΤΟΠΙΚΗ ΒΑΣΗ ΔΕΔΟΜΕΝΩΝ (SQLite)
# Δεν απαιτείται καμία ρύθμιση - δημιουργείται αυτόματα στο data/nexusfit.db

# 3. DOMAIN URL (Για SEO & Canonical Links)
NEXT_PUBLIC_SITE_URL=https://nexusathletics.gr

# 4. ΑΣΦΑΛΕΙΑ ΣΥΝΕΔΡΙΩΝ (ΑΠΑΙΤΕΙΤΑΙ ΣΤΟ PRODUCTION)
# Μυστικό για την υπογραφή (HMAC-SHA256) των cookies μελών.
# Χωρίς αυτό, η σύνδεση μέλους επιστρέφει 503 στο production.
# Δημιουργήστε ένα με: openssl rand -hex 32
SESSION_SECRET=change_me_with_a_long_random_secret

# 5. ΚΩΔΙΚΟΣ ΔΙΑΧΕΙΡΙΣΤΗ (ΑΠΑΙΤΕΙΤΑΙ ΓΙΑ ΤΟ /admin)
# Χρησιμοποιείται για το seed του default tenant στο registry (data/registry.db).
# Οι επιπλέον tenants έχουν ΔΙΚΟ ΤΟΥΣ κωδικό (βλ. scripts/create-tenant.mjs).
ADMIN_PASSWORD=change_me_admin_password

# 6. ΜΥΣΤΙΚΟ CRON (ΓΙΑ ΤΗ ΔΙΑΤΗΡΗΣΗ ΔΕΔΟΜΕΝΩΝ / RETENTION)
# Απαιτείται από το /api/cron/retention που διαγράφει παλιά leads (>12 μήνες).
CRON_SECRET=change_me_cron_secret
