# ==============================================================================
# NEXUSFIT PRODUCTION ENVIRONMENT (.env for docker compose)
# Copy to deploy/.env and fill the values. Never commit the filled file.
# ==============================================================================

# --- Domain & TLS -------------------------------------------------------------
# Caddy obtains the certificate automatically once DNS points here.
SITE_DOMAIN=example.com
# Build-time value used for canonical / OpenGraph URLs (rebuild to change).
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Required secrets ---------------------------------------------------------
# HMAC key for member session cookies. Without it (or under 16 chars) member
# login returns 503 in production. Generate with: openssl rand -hex 32
SESSION_SECRET=change_me_with_a_long_random_secret

# Optional member-session timeouts (seconds). Defaults: idle 7 days, absolute
# 30 days, last_seen write at most once per minute.
MEMBER_SESSION_IDLE_SECONDS=604800
MEMBER_SESSION_ABSOLUTE_SECONDS=2592000
MEMBER_SESSION_TOUCH_SECONDS=60
# Keep at most this many active sessions per member; oldest are revoked first.
MEMBER_SESSION_MAX_ACTIVE=10

# Seeds the default tenant's admin password in the registry on first run.
# Choose a real password; admin login returns 503 if this is unset.
ADMIN_PASSWORD=change_me_admin_password

# Optional legacy shared trainer password for the default tenant. Staff
# accounts created from Admin → Προσωπικό work even when this is empty.
TRAINER_PASSWORD=change_me_trainer_password

# Shared secret for the entrance/turnstile scanner (x-access-key header).
# At least 16 chars. If empty, QR access and /api/access/scan are disabled.
ACCESS_CONTROL_KEY=change_me_access_control_key

# Timezone used for the occupancy forecast (weekday/hour buckets).
GYM_TIMEZONE=Europe/Athens

# Shared secret for POST /api/cron/retention (used by the retention sidecar).
CRON_SECRET=change_me_cron_secret

# --- AI (optional) ------------------------------------------------------------
# Without a key the chat falls back to the deterministic local engine.
GEMINI_API_KEY=

# --- Design preview -----------------------------------------------------------
# Build-time flag. 0 hides the theme switcher and ?theme= override (recommended
# for the public host); set 1 only for a design preview build.
NEXT_PUBLIC_THEME_PREVIEW=0

# --- Do not set on a real deployment ------------------------------------------
# DEMO_MODE / SEED_DEMO_MEMBERS create known demo credentials. Leave unset.
